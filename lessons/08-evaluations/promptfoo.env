# Lektion 08 – Evaluierung: Einstellungen für promptfoo (Teil 5 und 6). Die npm-Skripte l08:5 und
# l08:6 laden diese Datei zusätzlich zur `.env` im Wurzelverzeichnis, vor allem anderen; Werte in den
# YAML-Dateien unter `env:` kämen für diese Schalter zu spät. Kein Geheimnis darin, deshalb im Repo.
# English: promptfoo settings for Lesson 08, Parts 5 and 6. The npm scripts l08:5 and l08:6 load this
# file in addition to the root `.env`, before anything else; values under `env:` in the YAML files would
# come too late for these switches. No secrets, so it is in the repo.

# Keine Nutzungsstatistik an die Entwickler von promptfoo. / No usage statistics sent to promptfoo's developers.
PROMPTFOO_DISABLE_TELEMETRY=true
# Keine Prüfung auf neue Versionen beim Start. / No check for new versions at startup.
PROMPTFOO_DISABLE_UPDATE=true
# Kein Hochladen von Ergebnissen in die promptfoo-Cloud (`promptfoo share`). / No uploading results to the promptfoo cloud.
PROMPTFOO_DISABLE_SHARING=true
# Keine Testfälle von promptfoos Servern erzeugen lassen. / No test generation on promptfoo's servers.
PROMPTFOO_DISABLE_REMOTE_GENERATION=true
